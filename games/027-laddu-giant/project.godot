; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Laddu Giant"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://addons/studio_core/save_manager.gd"
Settings="*res://addons/studio_core/settings.gd"
Analytics="*res://addons/studio_core/analytics.gd"
AudioManager="*res://addons/studio_core/audio_manager.gd"
Haptics="*res://addons/studio_core/haptics.gd"
AdsManager="*res://scripts/admob_adapter.gd"
SceneTransition="*res://addons/studio_core/scene_transition.gd"
DebugOverlay="*res://addons/studio_core/debug_overlay.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(1, 0.62, 0.3, 1)
