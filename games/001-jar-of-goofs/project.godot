; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Jar of Goofs"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/art/icon.png"

[autoload]

SaveManager="*res://addons/studio_core/save_manager.gd"
Settings="*res://addons/studio_core/settings.gd"
Analytics="*res://addons/studio_core/analytics.gd"
AudioManager="*res://addons/studio_core/audio_manager.gd"
Haptics="*res://addons/studio_core/haptics.gd"
AdsManager="*res://addons/studio_core/ads_manager.gd"
SceneTransition="*res://addons/studio_core/scene_transition.gd"
DebugOverlay="*res://addons/studio_core/debug_overlay.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

2d/default_gravity=3000.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12, 0.13, 0.17, 1)
